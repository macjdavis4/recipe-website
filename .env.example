# Copy to .env for local development:  cp .env.example .env
# Production values live in the PRODUCTION_ENV GitHub secret (see README).

# Database
# POSTGRES_* create the database (docker-compose.yml locally, the db service in
# production). Production builds DATABASE_URL from them, so it is not set there.
# Use letters and digits for the production password: openssl rand -hex 24
POSTGRES_USER="larder"
POSTGRES_PASSWORD="change-me-to-a-long-random-string"
POSTGRES_DB="larder"
DATABASE_URL="postgresql://larder:change-me-to-a-long-random-string@localhost:5432/larder"

# Auth.js. Generate a secret (32+ characters) with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"   # production: https://your-domain

# Optional Google sign-in (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI (server only, never expose to the client)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
AI_RATE_LIMIT_PER_HOUR=30
# "mock" uses a built-in stand-in (no key, no API calls). Blank means
# "anthropic", except in tests, which always use the mock.
AI_PROVIDER=""

# Image storage: "local" for dev, "spaces" for production
STORAGE_DRIVER="local"

# DigitalOcean Spaces (S3-compatible)
SPACES_KEY=""
SPACES_SECRET=""
SPACES_REGION="nyc3"
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
SPACES_BUCKET="larder-images"
SPACES_CDN_URL="https://larder-images.nyc3.cdn.digitaloceanspaces.com"
# Production only: a separate PRIVATE bucket for the nightly database dumps
SPACES_BACKUP_BUCKET="larder-backups"
# Days of nightly dumps to keep, on the Droplet and in Spaces (default 14)
BACKUP_RETENTION_DAYS=14

# Password for the demo users created by `pnpm db:seed`.
# Defaults to "cookbook-demo" outside production; required in production.
SEED_PASSWORD=""
